generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  phone         String?
  role          Role      @default(CUSTOMER)

  referralCode  String    @unique @default(cuid())
  referredById  String?
  referredBy    User?     @relation("Referrals", fields: [referredById], references: [id])
  referrals     User[]    @relation("Referrals")
  /// Denormalised SUM(PointsTransaction.amount). Writer: src/lib/points.ts only.
  pointsBalance Int       @default(0)
  pointRateChanges PointRateHistory[]

  orders              Order[]
  addresses           Address[]
  wishlist            WishlistItem[]
  reviews             Review[]
  testimonials        Testimonial[]
  reviewHelpfulVotes  ReviewHelpfulVote[]
  pointsHistory       PointsTransaction[]
  sessions            Session[]
  accounts            Account[]
  passwordResetTokens PasswordResetToken[]
  cartItems           CartItem[]
  consultationBookings ConsultationBooking[]
  savedPaymentMethods SavedPaymentMethod[]
  clientProfile       ClientProfile?
  staffProfile        StaffProfile?
  customerNotifications CustomerNotification[]
  staffNotifications    StaffNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  preferredGateway PaymentGateway?
  mustResetPassword Boolean @default(false)
  isActive          Boolean  @default(true)
  lastLogin         DateTime?
  /// Set on password reset / change so JWTs issued earlier (`iat`) are rejected.
  passwordChangedAt DateTime?

  jobRoleId  String?
  jobRole    JobRole? @relation("UserJobRole", fields: [jobRoleId], references: [id])
  jobTitle   String?
  department String?
  isStaff    Boolean  @default(false)

  paymentsConfirmed Payment[] @relation("PaymentConfirmedBy")
  stageCompletions  OrderStageCompletion[] @relation("StageCompletions")
  stageReverts      OrderStageCompletion[] @relation("StageReverts")
  stageMediaUploads OrderStageMedia[] @relation("StageMediaUploads")
  receiptsConfirmed BespokeOrder[] @relation("ReceiptConfirmedBy")
  userPermissions   UserPermission[]
  stockMovements    StockMovement[] @relation("StockMovementActor")
  adminNotificationReads AdminNotificationRead[]
  acknowledgedAdminNotifications AdminNotification[] @relation("AdminNotificationAck")
}

model Consultant {
  id           String   @id @default(cuid())
  name         String
  title        String
  bio          String   @db.Text
  image        String?
  isActive     Boolean  @default(true)
  isFlagship   Boolean  @default(false)
  displayOrder Int      @default(0)

  offerings    ConsultantOffering[]
  availability ConsultantAvailability[]
  blockedDates ConsultantBlockedDate[]
  bookings     ConsultationBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConsultantOffering {
  id              String                   @id @default(cuid())
  consultantId    String
  consultant      Consultant               @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  sessionType     ConsultationSessionType
  deliveryMode    ConsultationDeliveryMode
  durationMinutes Int
  feeNGN          Float
  feeUSD          Float?
  feeGBP          Float?
  isActive        Boolean                  @default(true)
  description     String?
  bookings        ConsultationBooking[]

  @@unique([consultantId, sessionType, deliveryMode])
}

model ConsultantAvailability {
  id             String     @id @default(cuid())
  consultantId   String
  consultant     Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  dayOfWeek      Int
  startTime      String
  endTime        String
  isActive       Boolean    @default(true)

  @@unique([consultantId, dayOfWeek])
}

model ConsultantBlockedDate {
  id             String     @id @default(cuid())
  consultantId   String
  consultant     Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  date           DateTime   @db.Date
  reason         String?
  createdAt      DateTime   @default(now())

  @@unique([consultantId, date])
}

model ConsultationBooking {
  id               String                    @id @default(cuid())
  bookingNumber    String                    @unique
  offeringId       String
  offering         ConsultantOffering        @relation(fields: [offeringId], references: [id])
  consultantId     String
  consultant       Consultant                @relation(fields: [consultantId], references: [id])

  userId           String?
  user             User?                     @relation(fields: [userId], references: [id])
  clientName       String
  clientEmail      String
  clientPhone      String
  clientCountry    String
  clientInstagram  String?

  occasion         String
  description      String                    @db.Text
  referenceImages  String[]                  @default([])

  preferredDate1   DateTime?
  preferredDate2   DateTime?
  preferredDate3   DateTime?
  confirmedDate    DateTime?
  confirmedTime    String?

  meetingLink      String?
  meetingPlatform  String?
  meetingLinkSentAt DateTime?
  atelierAddress     String?

  offeringType     String?
  virtualPlatform  String?

  sessionNotes     String?   @db.Text
  moodboardImages  String[]  @default([])
  moodboardNotes   String?   @db.Text

  confirmedAt      DateTime?
  confirmedBy      String?

  feeNGN           Float
  currency         Currency                  @default(NGN)
  paymentGateway   PaymentGateway?
  paymentRef       String?
  paymentStatus    PaymentStatus             @default(PENDING)
  paymentReceiptUrl String?
  paidAt           DateTime?

  status               ConsultationStatus @default(PENDING_PAYMENT)
  adminNotes           String?
  cancellationReason   String?

  completedAt   DateTime?
  adminFeedback String?   @db.Text

  invoices Invoice[]
  reviews  Review[]
  quotations  Quotation[]
  bespokeOrders BespokeOrder[]
  payments Payment[]

  reviewRequestSent Boolean @default(false)
  /// Set when the 48h unsent-quote alert has been sent (once per consultation).
  quoteAlertSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientEmail])
  @@index([status])
  @@index([confirmedDate])
  @@index([consultantId])
  @@index([status, quoteAlertSentAt, completedAt])
}

enum ConsultationSessionType {
  BESPOKE_DESIGN
  BRIDAL_CONSULTATION
  STYLING_SESSION
  WARDROBE_CONSULTATION
  GROUP_SESSION
  DISCOVERY_CALL
}

enum ConsultationDeliveryMode {
  VIRTUAL_STANDARD
  VIRTUAL_WITH_PRUDENT
  VIRTUAL_WITH_TEAM
  INPERSON_ATELIER
  INPERSON_ATELIER_PRUDENT
  INPERSON_HOME_TEAM
  INPERSON_HOME_PRUDENT
  PHONE_CALL
}

enum ConsultationStatus {
  PENDING_PAYMENT
  PENDING_CONFIRMATION
  CONFIRMED
  SCHEDULED
  IN_SESSION
  RESCHEDULED
  COMPLETED
  CANCELLED_BY_CLIENT
  CANCELLED_BY_ADMIN
  NO_SHOW
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PointsTransaction {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  type         PointsType
  amount       Int
  balanceAfter Int?
  description  String
  orderId      String?
  /// Naira per point locked on this row. Set on redeem and return so a later rate change cannot rewrite history.
  rateNGN      Float?
  /// When this credit lapses. Debits are null. Writer: src/lib/points.ts only.
  expiresAt    DateTime?
  /// Unspent remainder of a credit. Debits are 0. Writer: src/lib/points.ts only.
  remaining    Int         @default(0)
  createdAt    DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([orderId])
  @@index([expiresAt, remaining])
}

model Product {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  description    String          @db.Text
  details        String?         @db.Text
  metaTitle      String?
  metaDescription String?
  category       ProductCategory
  type           ProductType     @default(RTW)
  /// Denormalised cheapest effective unit (sale ₦ only while isOnSale). Filter, sort, wishlist.
  priceNGN       Float
  /// Same figure as priceNGN after save. Seed for new size rows in admin; not an independent catalog price.
  basePriceNGN   Float
  priceUSD       Float?
  priceGBP       Float?
  /// Cached: any variant.stock > 0. Written by recomputeVariantStock / syncProductInStock.
  inStock        Boolean         @default(true)
  isPublished    Boolean         @default(false)
  isFeatured     Boolean         @default(false)
  isNewArrival   Boolean         @default(false)
  isOnSale       Boolean         @default(false)
  saleEndsAt     DateTime?
  isBespokeAvail Boolean         @default(false)
  tags           String[]        @default([])
  orderCount     Int             @default(0)
  isBestSeller   Boolean         @default(false)
  /// Leftover product-level threshold. PDP and notify read ProductVariant.lowStockAt. Do not remove this slice.
  lowStockAt     Int             @default(3)

  /// Fallback parcel weight/dims when a variant leaves them blank. Carriers bill the greater of actual vs volumetric.
  defaultWeightKg  Float?
  defaultLengthCm  Float?
  defaultWidthCm   Float?
  defaultHeightCm  Float?
  packagingProfileId String?
  packagingProfile   PackagingProfile? @relation(fields: [packagingProfileId], references: [id], onDelete: SetNull)

  /// Offered on the product page as made-to-order. Does not consume size stock.
  customOffered          Boolean              @default(false)
  /// When standard sizes are gone, still offer made-to-measure. Default off: a sold-out one-off must not promise a remake.
  customOfferedWhenSoldOut Boolean            @default(false)
  /// Null inherits STORE custom_* settings.
  customSurchargeKind    CustomSurchargeKind?
  customSurchargeValue   Float?
  customLeadTimeDays     Int?
  customReturnable       Boolean?

  images              ProductImage[]
  variants            ProductVariant[]
  colors              ProductColor[]
  orderItems          OrderItem[]
  wishlistItems       WishlistItem[]
  reviews             Review[]
  bundleItems         BundleItem[]           @relation("BundleSource")
  inBundles           BundleItem[]           @relation("BundleTarget")
  cartItems           CartItem[]
  collections         CollectionProduct[]
  measurementFields   ProductMeasurement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, createdAt])
  @@index([isPublished, category])
  @@index([packagingProfileId])
}

model Collection {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  description     String?   @db.Text
  excerpt         String?
  coverImage      String?
  coverImageAlt   String?
  autoTag         String?
  isFeatured      Boolean   @default(false)
  isPublished     Boolean   @default(false)
  displayOrder    Int       @default(0)
  season          String?
  year            Int?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  products        CollectionProduct[]

  @@index([slug])
  @@index([isPublished, isFeatured])
}

model CollectionProduct {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())

  @@unique([collectionId, productId])
  @@index([collectionId])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductVariant {
  id           String      @id @default(cuid())
  /// Warehouse stock code. Generated from name + size unless skuManual.
  sku          String?     @unique
  /// True when someone typed a code by hand. Rename must not overwrite it.
  skuManual    Boolean     @default(false)
  size         String
  priceNGN     Float
  priceUSD     Float?
  priceGBP     Float?
  salePriceNGN Float?
  /// Cached sum of StockMovement.delta. Writer: recomputeVariantStock only.
  stock        Int         @default(0)
  lowStockAt   Int         @default(3)
  sortOrder    Int         @default(0)
  /// Size-specific parcel; null falls back to Product.default* then the default packaging profile.
  weightKg     Float?
  lengthCm     Float?
  widthCm      Float?
  heightCm     Float?
  productId    String
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems    CartItem[]
  stockAlerts  StockAlert[]
  orderItems   OrderItem[]
  stockMovements StockMovement[]
  updatedAt    DateTime    @default(now()) @updatedAt

  @@index([productId])
}

enum StockMovementReason {
  SALE
  CANCEL_RETURN
  REFUND_RETURN
  COUNT_CORRECTION
  RECEIPT
  WRITE_OFF
  OPENING
}

/// Source of truth for RTW size quantity. ProductVariant.stock is the cache.
model StockMovement {
  id        String              @id @default(cuid())
  variantId String
  variant   ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  delta     Int
  reason    StockMovementReason
  orderId   String?
  order     Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actorId   String?
  actor     User?               @relation("StockMovementActor", fields: [actorId], references: [id], onDelete: SetNull)
  note      String?
  createdAt DateTime            @default(now())

  @@index([variantId, createdAt])
  @@index([orderId])
}

model ProductColor {
  id        String     @id @default(cuid())
  name      String
  hex       String
  imageUrl  String?
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@index([productId])
}

model BundleItem {
  id              String  @id @default(cuid())
  sourceProductId String
  sourceProduct   Product @relation("BundleSource", fields: [sourceProductId], references: [id], onDelete: Cascade)
  targetProductId String
  targetProduct   Product @relation("BundleTarget", fields: [targetProductId], references: [id], onDelete: Cascade)
  sortOrder       Int     @default(0)

  @@unique([sourceProductId, targetProductId])
}

model CartItem {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  colorId   String?
  color     ProductColor?   @relation(fields: [colorId], references: [id], onDelete: SetNull)
  quantity  Int             @default(1)
  sizeMode  SizeMode        @default(STANDARD)
  /// Snapshot of typed measurements. Canonical centimetres live on each entry.
  measurements Json?
  typedUnit    String?
  surchargeNGN Float        @default(0)
  /// STANDARD:{variantId}:{colorId} or CUSTOM:{productId}:{colorId}
  lineKey   String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([userId, lineKey])
}

model StockAlert {
  id        String         @id @default(cuid())
  email     String
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([email, variantId])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
}

/// Token + suppression ledger for marketing mail (unsubscribe and hard bounce).
model EmailPreference {
  id               String    @id @default(cuid())
  email            String    @unique
  unsubscribeToken String    @unique @default(cuid())
  unsubscribedAt   DateTime?
  bounceAt         DateTime?
  bounceReason     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([unsubscribedAt])
}

/// Guest/logged-in checkout after email capture (Slice I). Snapshot, not a live cart FK.
model CheckoutSession {
  id             String    @id @default(cuid())
  email          String
  userId         String?
  cartSnapshot   Json
  currency       String    @default("NGN")
  furthestStep   Int       @default(1)
  lastActiveAt   DateTime  @default(now())
  recoveredAt    DateTime?
  orderId        String?
  remindersSent  Int       @default(0)
  restoreToken   String    @unique @default(cuid())
  lastReminderAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([email, recoveredAt])
  @@index([lastActiveAt, recoveredAt, remindersSent])
}

model Order {
  id               String           @id @default(cuid())
  orderNumber      String           @unique
  userId           String?
  user             User?            @relation(fields: [userId], references: [id])
  guestEmail       String?
  guestName        String?
  guestPhone       String?
  items            OrderItem[]
  subtotal         Float
  shippingAmount   Float            @default(0)
  discount         Float            @default(0)
  pointsDiscountNGN Float         @default(0)
  pointsUsed       Int              @default(0)
  /// Naira per point at redemption. A later rate change must not alter this order.
  pointsRateLocked Float?
  total            Float
  currency         Currency         @default(NGN)
  addressId        String?
  address          Address?         @relation(fields: [addressId], references: [id])
  addressSnapshot  Json?
  shippingZoneId   String?
  shippingZone     ShippingZone?    @relation(fields: [shippingZoneId], references: [id])
  shippingMethodId   String?
  shippingMethod     ShippingMethod? @relation(fields: [shippingMethodId], references: [id])
  shippingMethodKind ShippingMethodKind?
  lagosLocationId    String?
  lagosLocation      LagosLocation?  @relation(fields: [lagosLocationId], references: [id])
  pickupLocationId   String?
  pickupLocation     PickupLocation? @relation(fields: [pickupLocationId], references: [id])
  shippingQuoteStatus ShippingQuoteStatus @default(NONE)
  /// Locked carrier quote at order creation: amount, currency, service, billableKg, quotedAt.
  shippingQuoteLocked Json?
  shippingConsentAt   DateTime?
  /// Exact consent wording shown at checkout (not a boolean).
  shippingConsentText String?         @db.Text
  /// How the house should reach the client to agree shipping (Slice O).
  preferredContactMethod PreferredContactMethod?
  /// Note from the agreed quote conversation (carrier lives on `carrier`).
  shippingQuoteNote   String?         @db.Text
  collectionCode      String?
  collectionReadyAt   DateTime?
  collectedAt         DateTime?
  collectionRemindedAt DateTime?
  /// USD per ₦1, locked at checkout. Convert with convertFromNGN.
  fxRateLocked        Float?
  /// GBP per ₦1, locked at checkout with the USD rate.
  fxGbpRateLocked     Float?
  fxRateSource        String?
  fxRateFetchedAt     DateTime?
  fxRateStale         Boolean         @default(false)
  /// USD payable for order.total at lock time (line overrides + converted extras). Scale by outstanding/total.
  fxUsdAmountLocked   Float?
  /// GBP payable for order.total at lock time. Scale by outstanding/total.
  fxGbpAmountLocked   Float?
  /// Ledger denormalised cache. Writer: recomputeRtwOrderTotals.
  amountPaid          Float           @default(0)
  balance             Float           @default(0)
  couponId         String?
  coupon           Coupon?          @relation(fields: [couponId], references: [id])
  couponCode       String?
  couponUsage      CouponUsage?
  paymentGateway   PaymentGateway?
  paymentRef       String?
  paymentReceiptUrl String?
  paymentStatus    PaymentStatus    @default(PENDING)
  status           OrderStatus      @default(PENDING)
  notes            String?
  isGift           Boolean          @default(false)
  giftMessage      String?
  adminNotes       String?
  paidAt           DateTime?
  isBespoke        Boolean          @default(false)
  bespokeDetails   String?          @db.Text
  trackingNumber   String?
  carrier            String?

  reviewRequestSent Boolean @default(false)

  fulfilmentKind     OrderFulfilmentKind @default(STOCK)
  /// Guest checkout with at least one custom line — phone before cutting.
  guestCustom        Boolean             @default(false)
  customLeadTimeDays Int?
  customReturnable   Boolean             @default(true)

  /// When an oversell (or other) refund was recorded in-app, and by whom. PSP refund is still manual.
  refundRecordedAt         DateTime?
  refundRecordedById       String?
  refundRecordedByName     String?
  refundRecordedAmountNGN  Float?

  payments Payment[]
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
  @@index([shippingQuoteStatus])
  @@index([status, collectionReadyAt])
  @@index([guestCustom])
  @@index([fulfilmentKind])
}

model OrderItem {
  id         String          @id @default(cuid())
  orderId    String
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  quantity   Int
  size       String?
  color      String?
  colorHex   String?
  price      Float
  lineTotal  Float
  sizeMode   SizeMode        @default(STANDARD)
  /// Typed + canonical centimetre snapshot for the workroom.
  measurements Json?
  typedUnit    String?
  surchargeNGN Float         @default(0)
  customLeadTimeDays Int?
  customReturnable   Boolean?

  @@index([orderId])
  @@index([sizeMode])
}

model BespokeRequest {
  id              String        @id @default(cuid())
  requestNumber   String        @unique
  userId          String?
  name            String
  email           String
  phone           String
  country         String?
  source          String?
  occasion        String
  description     String        @db.Text
  budget          String?
  budgetRange     String?
  timeline        String?
  measurements    Json?
  referenceImages String[]      @default([])
  sketchUrls      String[]      @default([])
  status          BespokeStatus @default(PENDING)
  adminNotes      String?
  preferredDate   DateTime?
  estimatedPrice  Float?
  agreedPrice     Float?
  depositPaid     Float?
  paymentMethod   String?
  entrySource     String?

  /// Paystack reference used for the “pay balance online” link (manual admin flow).
  balancePaystackRef   String?
  balancePaymentStatus PaymentStatus?

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id               String          @id @default(cuid())
  invoiceNumber    String          @unique
  bespokeRequestId String?
  bespokeRequest   BespokeRequest? @relation(fields: [bespokeRequestId], references: [id], onDelete: SetNull)
  consultationId   String?
  consultation     ConsultationBooking? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  clientName      String
  clientEmail     String
  clientPhone     String?
  clientAddress   String?
  clientCity      String?
  clientCountry   String   @default("Nigeria")
  clientInstagram String?

  currency     String  @default("NGN")
  exchangeRate Float   @default(1)

  status InvoiceStatus @default(DRAFT)

  lineItems Json

  subtotal       Float
  discountType   String?
  discountValue  Float   @default(0)
  discountAmount Float   @default(0)
  vatEnabled     Boolean @default(false)
  vatPercent     Float   @default(0)
  vatAmount      Float   @default(0)
  total          Float

  depositRequired Float @default(0)
  depositPaid     Float @default(0)
  balanceDue      Float @default(0)

  paymentTerms    String?   @db.Text
  dueDate         DateTime?
  paidAt          DateTime?
  paymentMethod   String?
  paymentRef      String?

  notes      String? @db.Text
  clientNote String? @db.Text

  showVat      Boolean @default(false)
  showRcNumber Boolean @default(false)

  sentAt    DateTime?
  viewedAt  DateTime?
  viewCount Int       @default(0)

  publicToken String @unique @default(cuid())

  /// Append-only log for admin payment history UI: [{ recordedAt, amount, method, reference? }]
  /// Prefer Payment ledger rows; kept for back-compat until fully migrated.
  paymentHistory Json @default("[]")

  quotationId String?
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)

