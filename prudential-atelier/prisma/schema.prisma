model Quotation {
  id       String @id @default(cuid())
  /// Display reference: `QT-2026-0001` (v1) or `QT-2026-0001-v2` (revisions).
  quoteRef String @unique
  /// Stable stem shared across versions (`QT-2026-0001`).
  baseQuoteRef String
  version      Int    @default(1)

  clientName  String
  clientEmail String
  clientPhone String?

  lineItems Json
  subtotal  Float
  tax       Float  @default(0)
  discount  Float  @default(0)
  total     Float
  /// Document currency. EUR is valid here (manual atelier quotes); not a storefront switcher.
  currency  String @default("NGN")

  notes  String?     @db.Text
  status QuoteStatus @default(DRAFT)

  approvalToken String    @unique @default(cuid())
  approvedAt    DateTime?
  expiresAt     DateTime?
  /// Public client approval page URL (never a PDF).
  approvalUrl   String?
  /// URL of the generated quotation PDF (admin/public PDF route), set on send.
  pdfUrl        String?
  sentAt        DateTime?

  parentQuotationId String?
  parentQuotation   Quotation?  @relation("QuotationVersions", fields: [parentQuotationId], references: [id], onDelete: SetNull)
  childQuotations   Quotation[] @relation("QuotationVersions")

  consultationId String?
  consultation   ConsultationBooking? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  bespokeOrders BespokeOrder[]
  invoices      Invoice[]
  alterationRequests AlterationRequest[]

  createdBy String?
  /// User id who created this revision (null for original v1).
  revisedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([clientEmail])
  @@index([approvalToken])
  @@index([consultationId])
  @@index([baseQuoteRef, version])
  @@index([parentQuotationId])
}

