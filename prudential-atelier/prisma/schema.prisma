/// One bank account per currency × business line. Mrs. Prudent adds, edits, or
/// retires rows from admin — no deploy. Bank transfer is offered only when an
/// active row matches the cart's currency and line.
model BankAccount {
  id               String              @id @default(cuid())
  currency         BankAccountCurrency
  businessLine     BusinessLine
  accountName      String
  accountNumber    String
  bankName         String
  swiftBic         String?
  iban             String?
  sortCode         String?
  routingNumber    String?
  intermediaryBank String?             @db.Text
  instructions     String?             @db.Text
  feeBearer        WireFeeBearer?
  /// Amount in this account's currency. A shortfall within this margin still settles.
  feeTolerance     Decimal?            @db.Decimal(12, 2)
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([currency, businessLine])
  @@index([isActive, currency, businessLine])
}

/// Append-only money ledger. Never update `amount` on an existing row —
/// corrections are new rows (negative amount with the same purpose, or status REFUNDED).
/// BespokeOrder.amountPaid / balance and Invoice.depositPaid / balanceDue are
/// denormalised caches maintained only by recomputeOrderTotals / recomputeInvoiceTotals.
model Payment {
  id             String         @id @default(cuid())
  reference      String         @unique
  amount         Decimal        @db.Decimal(12, 2)
  currency       String         @default("NGN")
  method         PaymentMethod
  status         PaymentStatus
  purpose        PaymentPurpose
  receiptUrl     String?
  gatewayPayload Json?

  invoiceId       String?
  invoice         Invoice?             @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  bespokeOrderId  String?
  bespokeOrder    BespokeOrder?        @relation(fields: [bespokeOrderId], references: [id], onDelete: Restrict)
  consultationId  String?
  consultation    ConsultationBooking? @relation(fields: [consultationId], references: [id], onDelete: Restrict)
  orderId         String?
  order           Order?               @relation(fields: [orderId], references: [id], onDelete: Restrict)

  /// Paying party identifier — NOT a FK.
  /// Prefer User.id when a User row exists; otherwise the stable placeholder
  /// `email:<lowercase>` for guests without accounts (see resolveClientId).
  /// Cannot FK to User: guest placeholders are not User rows, and orphaning a
  /// ledger row on user-delete would erase money history (RESTRICT would also
  /// block deleting customers who have paid).
  ///
  /// IMMUTABLE — the append-only trigger rejects any UPDATE of this column, so a
  /// guest who later registers keeps `email:<lowercase>` on their older rows
  /// while newer rows carry User.id. Never rewrite it to reconcile the two.
  /// READ RULE: client-scoped queries MUST match BOTH identifiers via
  /// `clientId: { in: await resolveClientIdentifiers({ userId, email }) }`
  /// (see getClientPayments in src/lib/payments/ledger.ts), otherwise a client's
  /// guest-era payments disappear from their own history.
  clientId String

  confirmedById  String?
  confirmedBy    User?     @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmedAt    DateTime?
  rejectedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bespokeOrderId])
  @@index([invoiceId])
  @@index([clientId])
  @@index([status])
  @@index([orderId])
  @@index([consultationId])
}

model LoyaltyRule {
  id       String  @id @default(cuid())
  action   String  @unique
  points   Int
  isActive Boolean @default(true)
}

/// Append-only history of the naira-per-point rate. Changing the rate revalues every outstanding balance.
