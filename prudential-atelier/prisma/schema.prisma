enum EmailSendJobStatus {
  PENDING
  SENDING
  DONE
  FAILED
}

enum CronRunStatus {
  RUNNING
  OK
  FAILED
  TIMED_OUT
}

/// One row per cron invocation. A row stuck in RUNNING is the timeout signal
/// when the host kills the function before finish (e.g. Vercel Hobby 10s).
model CronRun {
  id         String        @id @default(cuid())
  job        String
  startedAt  DateTime      @default(now())
  finishedAt DateTime?
  status     CronRunStatus @default(RUNNING)
  processed  Int           @default(0)
  failed     Int           @default(0)
  /// True when the run stopped early with work still pending (time budget / batch).
  hasMore    Boolean       @default(false)
  error      String?       @db.Text
  host       String?

  @@index([job, startedAt])
  @@index([status, startedAt])
}

model EmailSendJob {
  id            String             @id @default(cuid())
  status        EmailSendJobStatus @default(PENDING)
  recipientType String
  total         Int
  sent          Int                @default(0)
  failed        Int                @default(0)
  nextIndex     Int                @default(0)
  recipients    Json
  subject       String
  body          String             @db.Text
  templateKey   String?
  collectionId  String?
  createdBy     String
  error         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status, createdAt])
}

enum EmailStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  DEAD
}

model EmailMessage {
  id                 String      @id @default(cuid())
  idempotencyKey     String      @unique
  to                 String
  cc                 String?
  bcc                String?
  fromAddress        String
  subject            String
  template           String
  html               String      @db.Text
  text               String?     @db.Text
  attachments        Json?
  status             EmailStatus @default(QUEUED)
  attempts           Int         @default(0)
  maxAttempts        Int         @default(5)
  nextAttemptAt      DateTime?
  lastError          String?     @db.Text
  provider           String?
  providerMessageId  String?
  sentAt             DateTime?
  relatedType        String?
  relatedId          String?
  /// Higher drains first. Transactional = 100; marketing campaigns = 0.
  priority           Int         @default(100)
  headers            Json?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([status, nextAttemptAt])
  @@index([relatedType, relatedId])
  @@index([template])
  @@index([priority, status, nextAttemptAt])
}
