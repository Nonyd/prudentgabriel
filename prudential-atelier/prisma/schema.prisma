  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  label    String
  date     DateTime
  /// Legacy single-shot flag. Interval tracking is `remindersSent`.
  notified Boolean  @default(false)
  remindersSent Int[] @default([])

  createdAt DateTime @default(now())
}

model ClientNote {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  note          String
  addedBy       String
  addedByName   String?

  createdAt DateTime @default(now())

  @@index([clientId])
}

model BespokeOrder {
  id       String @id @default(cuid())
  orderRef String @unique

  clientProfileId String?
  clientProfile   ClientProfile? @relation(fields: [clientProfileId], references: [id])
  clientName      String
  clientEmail     String
  clientPhone     String?

  outfitDescription String?  @db.Text
  occasionType      String?
  eventLocation     String?
  clientLocation    String?
  deliveryDate      DateTime?
  notes             String?  @db.Text

  currentStage BespokeStage @default(CONSULTATION_BOOKING)
  stageHistory     StageUpdate[]
  stageCompletions OrderStageCompletion[]
  stageMedia       OrderStageMedia[]
  stageDrafts      OrderStageDraft[]
  stageApprovals   StageApproval[]
  assignments  OrderAssignment[]
  materials    Material[]

  quotationId String?
  quotation   Quotation? @relation(fields: [quotationId], references: [id])
  /// Cached denormalised total of CONFIRMED Payment rows — only write via recomputeOrderTotals().
  amountPaid  Float      @default(0)
  totalAmount Float      @default(0)
  /// Cached denormalised (totalAmount - amountPaid) — only write via recomputeOrderTotals().
  balance     Float      @default(0)
  paymentGateway PaymentGateway?
  paymentRef     String?
  paymentReceiptUrl String?

  bespokeRequestId String?

  consultationId  String?
  consultation    ConsultationBooking? @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  sessionNotes    String?  @db.Text
  moodboardImages String[] @default([])
  occasionDetails String?
  outfitBrief     String?  @db.Text

  trackingToken String @unique @default(cuid())

  /// Set when depositSatisfied first becomes true (confirmed payments ≥ deposit). Sprint B gates stage advancement on this.
  productionUnlockedAt DateTime?

  /// Last time a balance-reminder email/notification was sent for this order.
  balanceReminderSentAt DateTime?

  /// When the DELIVERY stage completed (status → DELIVERED). Used for warranty + reminders.
  deliveredAt DateTime?

  receiptConfirmToken   String    @unique @default(cuid())
  receiptConfirmedAt    DateTime?
  receiptConfirmedById  String?
  receiptConfirmedBy    User?     @relation("ReceiptConfirmedBy", fields: [receiptConfirmedById], references: [id], onDelete: SetNull)
  receiptReminderSentAt DateTime?

  /// Bespoke review-request email sent once (mirrors RTW Order.reviewRequestSent).
  reviewRequestSent Boolean @default(false)

  status OrderStatus @default(PENDING)

  payments Payment[]
  alterationRequests AlterationRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trackingToken])
  @@index([clientEmail])
  @@index([status])
  @@index([consultationId])
  @@index([balance, balanceReminderSentAt, deliveryDate])
  @@index([deliveredAt, receiptConfirmedAt])
}

enum AlterationReason {
  FIT
  WORKMANSHIP
  DAMAGE
  CHANGE_REQUESTED
  OTHER
}

enum AlterationStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  IN_PROGRESS
  COMPLETED
}

enum AlterationPricing {
  FREE
  CHARGEABLE
}

/// Post-delivery alteration — separate from pipeline stage ALTERATIONS.
/// Chargeable path links a Quotation; free accepts require complimentaryEstimatedValue.
model AlterationRequest {
  id      String       @id @default(cuid())
  orderId String
  order   BespokeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  description String           @db.Text
  media       Json             @default("[]")
  reason      AlterationReason
  status      AlterationStatus @default(REQUESTED)

  /// Policy suggestion at triage time (warranty + reason).
  pricingDefault  AlterationPricing?
  /// Final decision (admin may override).
  pricingDecision AlterationPricing?
  pricingOverrideReason String? @db.Text

  /// Required when accepting FREE — estimated NGN cost of complimentary work.
  complimentaryEstimatedValue Float?

  declineReason String? @db.Text

  quotationId String?
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)

  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([orderId, status])
  @@index([clientId])
  @@index([status])
}

model StageUpdate {
  id      String       @id @default(cuid())
  orderId String
  order   BespokeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  stage           BespokeStage
  notes           String?  @db.Text
  images          String[]
  videos          String[]
  completedBy     String
  completedByName String?
  emailSent       Boolean  @default(false)
  emailSentAt     DateTime?

  completedAt DateTime @default(now())

  @@index([orderId])
}

enum StageApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  SUPERSEDED
}

enum StageMediaKind {
  IMAGE
  VIDEO
}

/// Persisted per-stage completion. Sequential integrity counts rows with revertedAt null.
/// Reverts preserve the row (revertedAt / revertedById / revertReason) — do not delete.
/// DB enforces at most one live row per (orderId, stage) via partial unique index
/// OrderStageCompletion_orderId_stage_live_key (see migration 20260809_stage_completion_live_unique).
model OrderStageCompletion {
  id            String       @id @default(cuid())
  orderId       String
  order         BespokeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stage         BespokeStage
  completedAt   DateTime     @default(now())
  completedById String
  completedBy   User         @relation("StageCompletions", fields: [completedById], references: [id])
  notes         String?      @db.Text
  revertedAt    DateTime?
  revertedById  String?
  revertedBy    User?        @relation("StageReverts", fields: [revertedById], references: [id])
  revertReason  String?      @db.Text

  @@index([orderId, stage])
  @@index([orderId, revertedAt])
}

/// Stage-scoped media. Null stage is not allowed — unscoped uploads cannot satisfy any gate.
model OrderStageMedia {
  id           String         @id @default(cuid())
  orderId      String
  order        BespokeOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stage        BespokeStage
  url          String
  kind         StageMediaKind @default(IMAGE)
  uploadedById String?
  uploadedBy   User?          @relation("StageMediaUploads", fields: [uploadedById], references: [id])
  createdAt    DateTime       @default(now())

  @@index([orderId, stage])
}

/// In-progress notes for the current stage (before completion / approval request).
model OrderStageDraft {
  id          String       @id @default(cuid())
  orderId     String
  order       BespokeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stage       BespokeStage
  notes       String       @db.Text
  updatedById String?
  updatedAt   DateTime     @updatedAt

