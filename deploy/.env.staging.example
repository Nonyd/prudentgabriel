# Copy to .env.staging in this folder (never commit). From deploy/:
#   docker compose --env-file .env.staging -f compose.staging.yaml ...

PA_MAIN_IMAGE=ghcr.io/nonyd/prudentgabriel
PA_IMAGE_TAG=staging
PA_MAIN_BIND=127.0.0.1:3011

POSTGRES_USER=pa_staging
POSTGRES_PASSWORD=
POSTGRES_DB=prudentgabriel_staging

NODE_ENV=production
CRON_HOST=vps-staging
DATABASE_URL=postgresql://pa_staging:PASSWORD@postgres:5432/prudentgabriel_staging
DIRECT_URL=postgresql://pa_staging:PASSWORD@postgres:5432/prudentgabriel_staging

NEXTAUTH_SECRET=
AUTH_SECRET=
NEXTAUTH_URL=https://staging.prudentgabriel.com
NEXT_PUBLIC_APP_URL=https://staging.prudentgabriel.com

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Use test/sandbox keys on staging
# PAYSTACK_SECRET_KEY=
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# FLUTTERWAVE_SECRET_KEY=
# NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
# STRIPE_WEBHOOK_SECRET=

# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=

# ENCRYPTION_KEY=
# SETTINGS_ENCRYPTION_KEY=

CRON_SECRET=
PRISMA_MIGRATE_DEPLOY_FATAL=1
RUN_DB_SEED_ON_START=safe

PORT=3000
HOSTNAME=0.0.0.0
