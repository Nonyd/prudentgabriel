# Copy to .env.production in this folder (never commit). From deploy/:
#   docker compose --env-file .env.production -f compose.production.yaml ...

# --- Container image (GHCR) ---
PA_MAIN_IMAGE=ghcr.io/nonyd/prudentgabriel
PA_IMAGE_TAG=production
# Pin a deploy: PA_IMAGE_TAG=<40-char-git-sha-from-GitHub-Actions>

# --- Host port binding (optional; Traefik uses the coolify network) ---
PA_MAIN_BIND=127.0.0.1:3010

# --- Postgres (Compose service `postgres` — not the PFA database) ---
POSTGRES_USER=pa_prod
POSTGRES_PASSWORD=
POSTGRES_DB=prudentgabriel

NODE_ENV=production
CRON_HOST=vps
DATABASE_URL=postgresql://pa_prod:PASSWORD@postgres:5432/prudentgabriel
DIRECT_URL=postgresql://pa_prod:PASSWORD@postgres:5432/prudentgabriel

# --- Auth (required) ---
NEXTAUTH_SECRET=
AUTH_SECRET=
NEXTAUTH_URL=https://prudentgabriel.com
NEXT_PUBLIC_APP_URL=https://prudentgabriel.com

# Optional Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Cloudinary ---
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# --- Payments ---
# PAYSTACK_SECRET_KEY=
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# FLUTTERWAVE_SECRET_KEY=
# NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
# STRIPE_WEBHOOK_SECRET=
# MONNIFY_API_KEY=
# MONNIFY_SECRET_KEY=
# MONNIFY_CONTRACT_CODE=
# MONNIFY_BASE_URL=https://api.monnify.com
# BANK_NAME=
# BANK_ACCOUNT_NUMBER=
# BANK_ACCOUNT_NAME=

# --- Email ---
# RESEND_API_KEY=
# SMTP_HOST=mail.prudentgabriel.com
# SMTP_PORT=465
# SMTP_USER=noreply@prudentgabriel.com
# SMTP_PASSWORD=

# --- Encryption (long random secrets) ---
# ENCRYPTION_KEY=
# SETTINGS_ENCRYPTION_KEY=

# --- Cron / ops ---
CRON_SECRET=
PRISMA_MIGRATE_DEPLOY_FATAL=1
# First boot only — bootstrap settings/admin. Unset after first successful start.
# RUN_DB_SEED_ON_START=safe

# ADMIN_EMAIL=admin@prudentgabriel.com
# SUPER_ADMIN_EMAIL=
# GENERAL_ADMIN_EMAIL=
# ORDERS_ADMIN_EMAIL=orders@prudentgabriel.com
# HR_MANAGER_EMAIL=hr@prudentgabriel.com

# OPEN_EXCHANGE_RATES_APP_ID=
# PFA_VERIFY_METHOD=mock
# PFA_API_URL=
# PFA_API_KEY=

PORT=3000
HOSTNAME=0.0.0.0
